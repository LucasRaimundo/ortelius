# Lista JSON de origens que podem chamar a API.
ORTELIUS_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Banco local do compose.yaml. Em outros ambientes, vem do gerenciador de segredos.
ORTELIUS_DATABASE_URL=postgresql+psycopg://ortelius:ortelius@localhost:5432/ortelius
# Geração de rascunhos de texto (pipeline.texto): gemini ou openrouter. Chaves nunca no repositório.
ORTELIUS_DRAFT_PROVIDER=gemini
# Vazio usa o padrão do provedor (gemini-flash-latest ou nvidia/nemotron-3.5-super-vl:free).
ORTELIUS_DRAFT_MODEL=
# Camada gratuita do Google AI Studio.
ORTELIUS_GEMINI_API_KEY=
# Conta do OpenRouter sem créditos: só modelos `:free`.
ORTELIUS_OPENROUTER_API_KEY=
# Originais das imagens enviadas pelo painel (pasta montada no Directus). Vazio: a API não serve imagens.
ORTELIUS_MEDIA_ROOT=var/uploads
# Tamanhos gerados das imagens; pode ser apagada, tudo é regenerado.
ORTELIUS_MEDIA_CACHE_DIR=var/media-cache
