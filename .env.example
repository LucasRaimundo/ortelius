# Lista JSON de origens que podem chamar a API.
ORTELIUS_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Banco local do compose.yaml. Em outros ambientes, vem do gerenciador de segredos.
ORTELIUS_DATABASE_URL=postgresql+psycopg://ortelius:ortelius@localhost:5432/ortelius
# Geração de rascunhos de texto (pipeline.texto). Chave da camada gratuita do Google AI Studio; nunca no repositório.
ORTELIUS_GEMINI_API_KEY=
# Modelo do Gemini; o apelido segue a versão Flash atual.
ORTELIUS_DRAFT_MODEL=gemini-flash-latest
