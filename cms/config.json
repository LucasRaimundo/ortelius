{
  "settings": {
    "project_name": "Atlas — Painel editorial",
    "default_language": "pt-BR",
    "public_registration": false
  },
  "hidden_fields": [
    "id",
    "created_at",
    "updated_at"
  ],
  "collections": {
    "entities": {
      "meta": {
        "icon": "public",
        "display_template": "{{name}}",
        "hidden": false,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Entidades",
            "singular": "Entidade",
            "plural": "Entidades"
          }
        ],
        "sort": 1,
        "note": "Lugares, povos, pessoas, acontecimentos e obras com página própria no Atlas.",
        "archive_field": "status",
        "archive_value": "archived",
        "unarchive_value": "draft",
        "archive_app_filter": true
      }
    },
    "sources": {
      "meta": {
        "icon": "menu_book",
        "display_template": "{{title}}",
        "hidden": false,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Fontes",
            "singular": "Fonte",
            "plural": "Fontes"
          }
        ],
        "sort": 2,
        "note": "Biblioteca Central: cada fonte é cadastrada uma vez e citada por várias entidades."
      }
    },
    "relation_types": {
      "meta": {
        "icon": "share",
        "display_template": "{{label}}",
        "hidden": false,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Tipos de relação",
            "singular": "Tipo de relação",
            "plural": "Tipos de relação"
          }
        ],
        "sort": 3,
        "note": "Vocabulário das relações entre entidades (ex.: \"participou de\")."
      }
    },
    "entity_aliases": {
      "meta": {
        "icon": "translate",
        "display_template": "{{alias}}",
        "hidden": true,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Nomes alternativos",
            "singular": "Nome alternativo",
            "plural": "Nomes alternativos"
          }
        ]
      }
    },
    "entity_sections": {
      "meta": {
        "icon": "article",
        "display_template": "{{title}}",
        "hidden": true,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Seções",
            "singular": "Seção",
            "plural": "Seções"
          }
        ]
      }
    },
    "entity_relations": {
      "meta": {
        "icon": "hub",
        "display_template": "{{relation_type.label}} {{target_entity_id.name}}",
        "hidden": true,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Relações",
            "singular": "Relação",
            "plural": "Relações"
          }
        ]
      }
    },
    "entity_sources": {
      "meta": {
        "icon": "format_quote",
        "display_template": "{{source_id.title}}",
        "hidden": true,
        "translations": [
          {
            "language": "pt-BR",
            "translation": "Citações",
            "singular": "Citação",
            "plural": "Citações"
          }
        ]
      }
    },
    "alembic_version": {
      "meta": {
        "hidden": true
      }
    }
  },
  "fields": {
    "entities": {
      "status": {
        "meta": {
          "interface": "select-dropdown",
          "sort": 1,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Status"
            }
          ],
          "hidden": false,
          "note": "Só entidades publicadas aparecem no Atlas. Publicar exige ao menos uma fonte.",
          "options": {
            "choices": [
              {
                "text": "Rascunho",
                "value": "draft"
              },
              {
                "text": "Publicado",
                "value": "published"
              },
              {
                "text": "Arquivado",
                "value": "archived"
              }
            ]
          },
          "display": "labels",
          "display_options": {
            "choices": [
              {
                "text": "Rascunho",
                "value": "draft"
              },
              {
                "text": "Publicado",
                "value": "published"
              },
              {
                "text": "Arquivado",
                "value": "archived"
              }
            ]
          }
        }
      },
      "entity_type": {
        "meta": {
          "interface": "select-dropdown",
          "sort": 2,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Tipo"
            }
          ],
          "hidden": false,
          "options": {
            "choices": [
              {
                "text": "Lugar",
                "value": "place"
              },
              {
                "text": "Civilização",
                "value": "civilization"
              },
              {
                "text": "Estado ou império",
                "value": "state"
              },
              {
                "text": "Pessoa",
                "value": "person"
              },
              {
                "text": "Acontecimento",
                "value": "event"
              },
              {
                "text": "Cultura",
                "value": "culture"
              },
              {
                "text": "Obra",
                "value": "work"
              },
              {
                "text": "Conceito",
                "value": "concept"
              }
            ]
          }
        }
      },
      "name": {
        "meta": {
          "interface": "input",
          "sort": 3,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Nome"
            }
          ],
          "hidden": false
        }
      },
      "slug": {
        "meta": {
          "interface": "input",
          "sort": 4,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Endereço (slug)"
            }
          ],
          "hidden": false,
          "note": "Usado na URL. Letras minúsculas sem acento, números e hífens (ex.: imperio-romano).",
          "options": {
            "slug": true
          },
          "validation": {
            "_and": [
              {
                "slug": {
                  "_regex": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              }
            ]
          },
          "validation_message": "Use só letras minúsculas sem acento, números e hífens (ex.: imperio-romano)."
        }
      },
      "summary": {
        "meta": {
          "interface": "input-multiline",
          "sort": 5,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Resumo"
            }
          ],
          "hidden": false,
          "note": "Uma ou duas frases. Aparece no cartão do globo e na busca."
        }
      },
      "description": {
        "meta": {
          "interface": "input-multiline",
          "sort": 6,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Introdução"
            }
          ],
          "hidden": false,
          "note": "Apresentação geral no topo da página."
        }
      },
      "cover_media": {
        "meta": {
          "interface": "file-image",
          "sort": 7,
          "width": "half",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Imagem de capa"
            }
          ],
          "hidden": false,
          "note": "Registre a licença e a atribuição da imagem nas fontes.",
          "special": [
            "file"
          ]
        }
      },
      "location": {
        "meta": {
          "interface": "map",
          "sort": 8,
          "width": "half",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Localização"
            }
          ],
          "hidden": false,
          "note": "Ponto do marcador no globo. Deixe vazio para entidades sem lugar físico (ex.: obras).",
          "options": {
            "geometryType": "Point"
          }
        }
      },
      "sections": {
        "meta": {
          "interface": "list-o2m",
          "sort": 9,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Seções"
            }
          ],
          "hidden": false,
          "options": {
            "template": "{{position}}. {{title}}"
          },
          "special": [
            "o2m"
          ]
        },
        "type": "alias"
      },
      "relations": {
        "meta": {
          "interface": "list-o2m",
          "sort": 10,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Relações"
            }
          ],
          "hidden": false,
          "note": "Relações a partir desta entidade. A relação também aparece na página da outra entidade.",
          "options": {
            "template": "{{relation_type.label}} → {{target_entity_id.name}}"
          },
          "special": [
            "o2m"
          ]
        },
        "type": "alias"
      },
      "aliases": {
        "meta": {
          "interface": "list-o2m",
          "sort": 11,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Nomes alternativos"
            }
          ],
          "hidden": false,
          "note": "Nomes históricos, variantes e transliterações. Usados na busca.",
          "options": {
            "template": "{{alias}}"
          },
          "special": [
            "o2m"
          ]
        },
        "type": "alias"
      },
      "citations": {
        "meta": {
          "interface": "list-o2m",
          "sort": 12,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Fontes"
            }
          ],
          "hidden": false,
          "note": "Ao menos uma fonte é obrigatória para publicar.",
          "options": {
            "template": "{{source_id.title}}"
          },
          "special": [
            "o2m"
          ]
        },
        "type": "alias"
      }
    },
    "entity_sections": {
      "entity_id": {
        "meta": {
          "interface": "select-dropdown-m2o",
          "sort": 1,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Entidade"
            }
          ],
          "hidden": false,
          "options": {
            "template": "{{name}}"
          }
        }
      },
      "title": {
        "meta": {
          "interface": "input",
          "sort": 2,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Título"
            }
          ],
          "hidden": false
        }
      },
      "section_key": {
        "meta": {
          "interface": "input",
          "sort": 3,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Chave"
            }
          ],
          "hidden": false,
          "note": "Identificador estável para navegação. Letras minúsculas sem acento, números e hífens (ex.: visao-geral).",
          "options": {
            "slug": true
          },
          "validation": {
            "_and": [
              {
                "section_key": {
                  "_regex": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              }
            ]
          },
          "validation_message": "Use só letras minúsculas sem acento, números e hífens (ex.: visao-geral)."
        }
      },
      "position": {
        "meta": {
          "interface": "input",
          "sort": 4,
          "width": "half",
          "required": true,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Ordem"
            }
          ],
          "hidden": false,
          "note": "Posição da seção na página (1, 2, 3...)."
        }
      },
      "content": {
        "meta": {
          "interface": "input-block-editor",
          "sort": 5,
          "width": "full",
          "required": false,
          "translations": [
            {
              "language": "pt-BR",
              "translation": "Conteúdo"
            }
          ],
          "hidden": false,
          "note": "Títulos, parágrafos, listas e citações. Negrito, itálico e links são preservados; outras formatações são descartadas.",
          "options": {
            "tools": [
              "header",
              "paragraph",
              "nestedlist",
              "quote"
            ],
            "placeholder": "Escreva a seção…"
          }
        }
      }
    },
    "entity_aliases": {
      "entity_id": {
        "meta": {
          "interface": "select-dropdown-m2o",
          "sort": 1,
          "width": "half",
          "required": true,
